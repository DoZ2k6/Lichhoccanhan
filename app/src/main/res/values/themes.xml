<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LichHocCaNhan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.LichHocCaNhan" parent="Base.Theme.LichHocCaNhan" />

    <!-- Hộp thoại tối cho AlertDialog -->
    <style name="HopThoaiToi" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#1B1E29</item>
        <item name="android:colorBackgroundFloating">#1B1E29</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9A9FAE</item>
        <item name="android:colorAccent">#12D8B8</item>
    </style>
    <style name="NhanForm">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OForm">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#6B7080</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="CuonGioToi" parent="android:Theme.Material">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9A9FAE</item>
        <item name="android:colorAccent">#12D8B8</item>
    </style>
</resources>