<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12141C"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnQuayLai"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="Quay lại"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvTieuDe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Thêm hoạt động"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/NhanForm"
                android:layout_marginTop="8dp"
                android:text="Tên hoạt động" />

            <EditText
                android:id="@+id/edtTen"
                style="@style/OForm"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/NhanForm"
                android:text="Loại" />

            <LinearLayout
                android:id="@+id/khungLoai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/NhanForm"
                android:text="Lặp lại" />

            <LinearLayout
                android:id="@+id/khungLap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/khungChonThu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/NhanForm"
                    android:text="Các thứ trong tuần" />

                <LinearLayout
                    android:id="@+id/khungThu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/khungChonNgay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/NhanForm"
                    android:text="Ngày" />

                <TextView
                    android:id="@+id/tvNgay"
                    style="@style/OForm"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Chọn ngày"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                style="@style/NhanForm"
                android:text="Giờ" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBatDau"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:textColor="#12D8B8"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="→"
                        android:textColor="#9A9FAE"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvKetThuc"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:textColor="#12D8B8"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvThoiLuong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="#9A9FAE"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/khungThoiLuong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                style="@style/NhanForm"
                android:text="Lớp (tùy chọn)" />

            <EditText
                android:id="@+id/edtLop"
                style="@style/OForm"
                android:hint="Ví dụ: 24DTH1D"
                android:inputType="textCapCharacters" />

            <TextView
                style="@style/NhanForm"
                android:text="Địa điểm (tùy chọn)" />

            <EditText
                android:id="@+id/edtDiaDiem"
                style="@style/OForm"
                android:hint="Ví dụ: L.403"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/NhanForm"
                android:text="Học kỳ (tùy chọn)" />

            <EditText
                android:id="@+id/edtHocKy"
                style="@style/OForm"
                android:hint="Ví dụ: HK1"
                android:inputType="textCapCharacters" />

            <TextView
                style="@style/NhanForm"
                android:text="Ghi chú (tùy chọn)" />

            <EditText
                android:id="@+id/edtGhiChu"
                style="@style/OForm"
                android:hint="Ghi chú thêm"
                android:inputType="textCapSentences" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnXoa"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_btn_xoa"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Xóa hoạt động này"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnLuu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Thêm"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>